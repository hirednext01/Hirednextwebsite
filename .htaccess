RewriteEngine On

# Canonicalise legacy/marketing GCC entry points to the dedicated GCC authority page.
RewriteRule ^gcc-recruitment-india/?$ /industry/global-capability-centres-hiring-india [R=301,L,NE]
RewriteRule ^gcc-talent-mapping-india/?$ /industry/global-capability-centres-hiring-india [R=301,L,NE]
RewriteRule ^regions/gcc-talent-mapping-india/?$ /industry/global-capability-centres-hiring-india [R=301,L,NE]

RewriteRule ^$ public/ [L]
RewriteRule (.*) public/$1 [L]