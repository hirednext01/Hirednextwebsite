{
  "display_information": {
    "name": "HiredNext Revenue Council",
    "description": "Routes HiredNext Slack revenue-room messages to Lyzr agents and posts decisions back into the same thread.",
    "background_color": "#111827"
  },
  "features": {
    "bot_user": {
      "display_name": "HiredNext Revenue Council",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://hirednext.net/webhooks/slack/revenue-council",
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
